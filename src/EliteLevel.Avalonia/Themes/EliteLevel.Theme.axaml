<!-- Elite Level Design System v3.0.0 for Avalonia 11.x. Generated from tokens.json; do not hand-edit values.
     Merge into App.axaml: <ResourceInclude Source="avares://EliteLevel.Avalonia/Themes/EliteLevel.Theme.axaml"/>
     No backdrop blur is used anywhere. Gradients are layered Borders (see reference/avalonia.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

