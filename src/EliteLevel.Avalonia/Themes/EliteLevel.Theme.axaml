  <SolidColorBrush x:Key="ElChipOnArtBrush" Color="{StaticResource ElChipOnArt}"/>
  <SolidColorBrush x:Key="ElChipOnArtStrongBrush" Color="{StaticResource ElChipOnArtStrong}"/>
  <SolidColorBrush x:Key="ElGhostOnFeatureBrush" Color="{StaticResource ElGhostOnFeature}"/>
