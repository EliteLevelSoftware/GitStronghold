  <SolidColorBrush x:Key="ElGoldDimBrush" Color="{StaticResource ElGoldDim}"/>
  <SolidColorBrush x:Key="ElGoldWarmBrush" Color="{StaticResource ElGoldWarm}"/>
  <SolidColorBrush x:Key="ElGoldGlowBrush" Color="{StaticResource ElGoldGlow}"/>
  <SolidColorBrush x:Key="ElGoldTextBrush" Color="{StaticResource ElGoldText}"/>
