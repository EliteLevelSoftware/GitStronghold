  <SolidColorBrush x:Key="ElCharcoal950Brush" Color="{StaticResource ElCharcoal950}"/>
  <SolidColorBrush x:Key="ElCharcoal900Brush" Color="{StaticResource ElCharcoal900}"/>
  <SolidColorBrush x:Key="ElCharcoal850Brush" Color="{StaticResource ElCharcoal850}"/>
  <SolidColorBrush x:Key="ElCharcoal800Brush" Color="{StaticResource ElCharcoal800}"/>
  <SolidColorBrush x:Key="ElCharcoal750Brush" Color="{StaticResource ElCharcoal750}"/>
  <SolidColorBrush x:Key="ElCharcoal700Brush" Color="{StaticResource ElCharcoal700}"/>
  <SolidColorBrush x:Key="ElCharcoal600Brush" Color="{StaticResource ElCharcoal600}"/>
  <SolidColorBrush x:Key="ElOxblood950Brush" Color="{StaticResource ElOxblood950}"/>
  <SolidColorBrush x:Key="ElOxblood900Brush" Color="{StaticResource ElOxblood900}"/>
  <SolidColorBrush x:Key="ElOxblood850Brush" Color="{StaticResource ElOxblood850}"/>
