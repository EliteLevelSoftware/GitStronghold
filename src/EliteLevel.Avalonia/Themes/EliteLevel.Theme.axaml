  <Color x:Key="ElGoldText">#E8C84A</Color>
  <Color x:Key="ElGoldEyebrow">#D4AF37</Color>
  <Color x:Key="ElText">#F0E8E0</Color>
  <Color x:Key="ElTextStrong">#F0E8E0</Color>
  <Color x:Key="ElTextOnFeature">#FFF7EE</Color>
  <Color x:Key="ElText2">#C8BAB0</Color>
  <Color x:Key="ElText3">#907870</Color>
  <Color x:Key="ElTextMuted">#9C8278</Color>
  <Color x:Key="ElTextFaint">#584848</Color>
  <Color x:Key="ElTextOnGold">#1A1010</Color>
  <Color x:Key="ElSuccess">#238232</Color>
  <Color x:Key="ElInfo">#4682D2</Color>
  <Color x:Key="ElWarning">#D4AF37</Color>
  <Color x:Key="ElDanger">#B43232</Color>
  <Color x:Key="ElCaptionCloseHover">#C42B1C</Color>
  <Color x:Key="ElGoldDark">#A08020</Color>
  <Color x:Key="ElGoldBtnHi">#E2C25A</Color>
  <Color x:Key="ElCrimson">#C41E3A</Color>
  <Color x:Key="ElCrimsonHi">#D42040</Color>
  <Color x:Key="ElCrimsonMid">#8B0018</Color>
  <Color x:Key="ElCrimsonDeep">#4A000C</Color>
  <Color x:Key="ElCrimsonEdge">#E03050</Color>
  <Color x:Key="ElRecord">#E0304E</Color>
  <Color x:Key="ElRecordIdleHi">#2A1A1A</Color>
  <Color x:Key="ElRecordIdleMid">#160C0C</Color>
  <Color x:Key="ElRecordIdleEdge">#7A2A2A</Color>
  <Color x:Key="ElFrame">#5A2020</Color>
  <Color x:Key="ElFrameToast">#4A2020</Color>
  <Color x:Key="ElBorderCard">#381C1C</Color>
  <Color x:Key="ElBorderControl">#2A1414</Color>
  <Color x:Key="ElBorderButton">#461E1E</Color>
  <Color x:Key="ElBorderToggle">#501E1E</Color>
  <Color x:Key="ElToggleOff">#261414</Color>
  <Color x:Key="ElSuccessText">#7FBF8A</Color>
  <Color x:Key="ElDangerText">#E08080</Color>
  <Color x:Key="ElStageHi">#180A0A</Color>
  <Color x:Key="ElStageLo">#060202</Color>
  <Color x:Key="ElBorderNavCard">#381C1C</Color>
  <Color x:Key="ElDivider">#2A1414</Color>
  <Color x:Key="ElBorderChip">#38D4AF37</Color>
  <Color x:Key="ElChipOnArt">#8C140E0F</Color>
  <Color x:Key="ElChipOnArtStrong">#99140E0F</Color>
  <Color x:Key="ElGhostOnFeature">#6B180A0C</Color>
  <Color x:Key="ElTextOnFeature2">#C7FFF0E4</Color>
  <Color x:Key="ElTextOnFeature3">#B8FFF0E4</Color>
  <Color x:Key="ElFocusRing">#E6D4AF37</Color>
  <Color x:Key="ElScrim">#9E080506</Color>
  <Color x:Key="ElGoldFill">#14D4AF37</Color>
  <Color x:Key="ElGoldEdge">#4CD4AF37</Color>
  <Color x:Key="ElGoldSelect">#1FD4AF37</Color>
  <Color x:Key="ElGoldSelectEdge">#59D4AF37</Color>
