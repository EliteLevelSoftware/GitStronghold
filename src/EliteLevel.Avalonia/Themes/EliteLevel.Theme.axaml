  <SolidColorBrush x:Key="ElTextBrush" Color="{StaticResource ElText}"/>
  <SolidColorBrush x:Key="ElTextStrongBrush" Color="{StaticResource ElTextStrong}"/>
  <SolidColorBrush x:Key="ElTextOnFeatureBrush" Color="{StaticResource ElTextOnFeature}"/>
  <SolidColorBrush x:Key="ElText2Brush" Color="{StaticResource ElText2}"/>
  <SolidColorBrush x:Key="ElText3Brush" Color="{StaticResource ElText3}"/>
  <SolidColorBrush x:Key="ElTextMutedBrush" Color="{StaticResource ElTextMuted}"/>
  <SolidColorBrush x:Key="ElTextFaintBrush" Color="{StaticResource ElTextFaint}"/>
  <SolidColorBrush x:Key="ElTextOnGoldBrush" Color="{StaticResource ElTextOnGold}"/>
  <SolidColorBrush x:Key="ElSuccessBrush" Color="{StaticResource ElSuccess}"/>
  <SolidColorBrush x:Key="ElInfoBrush" Color="{StaticResource ElInfo}"/>
  <SolidColorBrush x:Key="ElWarningBrush" Color="{StaticResource ElWarning}"/>
  <SolidColorBrush x:Key="ElDangerBrush" Color="{StaticResource ElDanger}"/>
  <SolidColorBrush x:Key="ElCaptionCloseHoverBrush" Color="{StaticResource ElCaptionCloseHover}"/>
  <SolidColorBrush x:Key="ElGoldDarkBrush" Color="{StaticResource ElGoldDark}"/>
  <SolidColorBrush x:Key="ElGoldBtnHiBrush" Color="{StaticResource ElGoldBtnHi}"/>
  <SolidColorBrush x:Key="ElCrimsonBrush" Color="{StaticResource ElCrimson}"/>
  <SolidColorBrush x:Key="ElCrimsonHiBrush" Color="{StaticResource ElCrimsonHi}"/>
  <SolidColorBrush x:Key="ElCrimsonMidBrush" Color="{StaticResource ElCrimsonMid}"/>
  <SolidColorBrush x:Key="ElCrimsonDeepBrush" Color="{StaticResource ElCrimsonDeep}"/>
  <SolidColorBrush x:Key="ElCrimsonEdgeBrush" Color="{StaticResource ElCrimsonEdge}"/>
  <SolidColorBrush x:Key="ElRecordBrush" Color="{StaticResource ElRecord}"/>
  <SolidColorBrush x:Key="ElRecordIdleHiBrush" Color="{StaticResource ElRecordIdleHi}"/>
  <SolidColorBrush x:Key="ElRecordIdleMidBrush" Color="{StaticResource ElRecordIdleMid}"/>
  <SolidColorBrush x:Key="ElRecordIdleEdgeBrush" Color="{StaticResource ElRecordIdleEdge}"/>
  <SolidColorBrush x:Key="ElFrameBrush" Color="{StaticResource ElFrame}"/>
  <SolidColorBrush x:Key="ElFrameToastBrush" Color="{StaticResource ElFrameToast}"/>
  <SolidColorBrush x:Key="ElBorderCardBrush" Color="{StaticResource ElBorderCard}"/>
  <SolidColorBrush x:Key="ElBorderControlBrush" Color="{StaticResource ElBorderControl}"/>
  <SolidColorBrush x:Key="ElBorderButtonBrush" Color="{StaticResource ElBorderButton}"/>
  <SolidColorBrush x:Key="ElBorderToggleBrush" Color="{StaticResource ElBorderToggle}"/>
  <SolidColorBrush x:Key="ElToggleOffBrush" Color="{StaticResource ElToggleOff}"/>
