  <Color x:Key="ElRecordGlow">#B2E0304E</Color>
  <Color x:Key="ElPanelTop">#B8321418</Color>
  <Color x:Key="ElPanelBottom">#D9180F0F</Color>
  <Color x:Key="ElInnerHighlight">#0AFFFFFF</Color>

  <!-- Brushes -->
