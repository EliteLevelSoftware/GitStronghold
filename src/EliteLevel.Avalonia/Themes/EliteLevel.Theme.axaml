  <SolidColorBrush x:Key="ElTextOnFeature3Brush" Color="{StaticResource ElTextOnFeature3}"/>
  <SolidColorBrush x:Key="ElFocusRingBrush" Color="{StaticResource ElFocusRing}"/>
  <SolidColorBrush x:Key="ElScrimBrush" Color="{StaticResource ElScrim}"/>
