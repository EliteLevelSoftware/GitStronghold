<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:GitStronghold.App"
             x:Class="GitStronghold.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EliteLevel.Avalonia/Themes/EliteLevel.Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:FileImageConverter x:Key="FileImage"/>
      <!-- Shell sizes that are not design-system tokens. Colours stay in the v3 dictionary. -->
      <x:Double x:Key="ElSizeChrome">24</x:Double>
      <x:Double x:Key="ElSizeWindowW">1320</x:Double>
      <x:Double x:Key="ElSizeWindowH">860</x:Double>
      <x:Double x:Key="ElSizeWindowMinW">960</x:Double>
      <x:Double x:Key="ElSizeWindowMinH">640</x:Double>
      <x:Double x:Key="ElSizePageMax">720</x:Double>
      <x:Double x:Key="ElSizeMarkerH">24</x:Double>
      <x:Double x:Key="ElSizeDialogW">560</x:Double>
      <x:Double x:Key="ElSizeMark">32</x:Double>
      <x:Double x:Key="ElSizeMarkInner">11</x:Double>
      <x:Double x:Key="ElSizeMarkCore">4</x:Double>
      <x:Double x:Key="ElSizePreview">240</x:Double>
      <x:Double x:Key="ElSizeViewer">420</x:Double>
      <Thickness x:Key="ElThicknessNone">0</Thickness>
      <Thickness x:Key="ElThicknessHairline">1</Thickness>
      <Thickness x:Key="ElThicknessTop">1,0,0,0</Thickness>
      <Thickness x:Key="ElThicknessFocus">2</Thickness>
      <Thickness x:Key="ElThicknessNav">30,0</Thickness>
      <Thickness x:Key="ElThicknessField">12,0</Thickness>
      <Thickness x:Key="ElThicknessSearch">16,0,10,0</Thickness>
      <Thickness x:Key="ElThicknessDanger">2,0,0,0</Thickness>
      <Thickness x:Key="ElThicknessMarkRing">1</Thickness>
      <Thickness x:Key="ElThicknessMarkFill">6</Thickness>
      <BoxShadows x:Key="ElShadowNone">0 0 0 0 #00000000</BoxShadows>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://EliteLevel.Avalonia/Themes/Controls.axaml"/>
  </Application.Styles>
</Application>
