  <SolidColorBrush x:Key="ElGoldEdgeBrush" Color="{StaticResource ElGoldEdge}"/>
  <SolidColorBrush x:Key="ElGoldSelectBrush" Color="{StaticResource ElGoldSelect}"/>
  <SolidColorBrush x:Key="ElGoldSelectEdgeBrush" Color="{StaticResource ElGoldSelectEdge}"/>
  <SolidColorBrush x:Key="ElToggleOnBrush" Color="{StaticResource ElToggleOn}"/>
  <SolidColorBrush x:Key="ElSuccessFillBrush" Color="{StaticResource ElSuccessFill}"/>
  <SolidColorBrush x:Key="ElSuccessEdgeBrush" Color="{StaticResource ElSuccessEdge}"/>
  <SolidColorBrush x:Key="ElCrimsonRingBrush" Color="{StaticResource ElCrimsonRing}"/>
  <SolidColorBrush x:Key="ElRecordGlowBrush" Color="{StaticResource ElRecordGlow}"/>
  <SolidColorBrush x:Key="ElPanelTopBrush" Color="{StaticResource ElPanelTop}"/>
  <SolidColorBrush x:Key="ElPanelBottomBrush" Color="{StaticResource ElPanelBottom}"/>
  <SolidColorBrush x:Key="ElInnerHighlightBrush" Color="{StaticResource ElInnerHighlight}"/>

  <!-- Feature card: three stacked Borders in one Panel, bottom to top: FeatureBase, FeatureGoldGlow, FeatureOxbloodGlow.
       160deg CSS linear maps to StartPoint 33%,3% EndPoint 67%,97% on a near-square card. -->
  <LinearGradientBrush x:Key="ElGradFeatureBase" StartPoint="33%,3%" EndPoint="67%,97%">
    <GradientStop Offset="0" Color="#2A0A0F"/>
    <GradientStop Offset="0.45" Color="#6E1F29"/>
    <GradientStop Offset="0.70" Color="#8A2A35"/>
    <GradientStop Offset="1" Color="#B9862E"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ElGradFeatureGoldGlow" Center="0%,105%" GradientOrigin="0%,105%" RadiusX="110%" RadiusY="90%">
    <GradientStop Offset="0" Color="#F2DEB440"/>
    <GradientStop Offset="0.58" Color="#00DEB440"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="ElGradFeatureOxbloodGlow" Center="92%,8%" GradientOrigin="92%,8%" RadiusX="90%" RadiusY="80%">
    <GradientStop Offset="0" Color="#F2C83E46"/>
    <GradientStop Offset="0.60" Color="#00C83E46"/>
  </RadialGradientBrush>

  <!-- Hero art layers (used when the art is generated in-app rather than a pre-rendered bitmap) -->
  <LinearGradientBrush x:Key="ElGradHeroArtBase" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#120A0B"/>
    <GradientStop Offset="0.5" Color="#3A1117"/>
    <GradientStop Offset="1" Color="#5E1C24"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ElGradHeroGlow" Center="72%,50%" GradientOrigin="72%,50%" RadiusX="55%" RadiusY="55%">
    <GradientStop Offset="0" Color="#8CD4AF37"/>
    <GradientStop Offset="0.35" Color="#738A2A35"/>
    <GradientStop Offset="1" Color="#008A2A35"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="ElGradHeroScrim" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="#EB0D0708"/>
    <GradientStop Offset="0.45" Color="#8C0D0708"/>
    <GradientStop Offset="1" Color="#000D0708"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ElGradTileScrim" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#000A0607"/>
    <GradientStop Offset="1" Color="#D10A0607"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ElGradVignette" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="75%" RadiusY="75%">
    <GradientStop Offset="0.55" Color="#00000000"/>
    <GradientStop Offset="1" Color="#8C000000"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="ElGradMarkGold" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#F0D785"/>
    <GradientStop Offset="1" Color="#B48C28"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ElGradBackdrop" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="120%" RadiusY="90%">
    <GradientStop Offset="0" Color="#353032"/>
    <GradientStop Offset="0.6" Color="#272325"/>
    <GradientStop Offset="1" Color="#1F1C1D"/>
  </RadialGradientBrush>
  <!-- Film grain: tile assets/grain-256.png at Opacity 0.07 over art only -->
  <ImageBrush x:Key="ElGrainBrush" Source="avares://EliteLevel.Avalonia/Assets/grain-256.png" TileMode="Tile" DestinationRect="0,0,256,256" Opacity="0.07"/>

  <!-- v3 surfaces: panel, primary and crimson buttons, stage, toast, floating bar, progress -->
  <LinearGradientBrush x:Key="ElGradPanel" StartPoint="0%,0%" EndPoint="100%,100%">  <!-- layer over ElCharcoal900Brush -->
    <GradientStop Offset="0" Color="#B8321418"/>
    <GradientStop Offset="1" Color="#D9180F0F"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ElGradGoldButton" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#E2C25A"/>
    <GradientStop Offset="1" Color="#B48C28"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ElGradCrimsonButton" Center="38%,32%" GradientOrigin="38%,32%" RadiusX="80%" RadiusY="80%">
    <GradientStop Offset="0" Color="#D42040"/>
    <GradientStop Offset="0.55" Color="#8B0018"/>
    <GradientStop Offset="1" Color="#4A000C"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="ElGradRecordButton" Center="38%,32%" GradientOrigin="38%,32%" RadiusX="80%" RadiusY="80%">
    <GradientStop Offset="0" Color="#2A1A1A"/>
    <GradientStop Offset="0.6" Color="#160C0C"/>
    <GradientStop Offset="1" Color="#0C0606"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="ElGradStage" Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
    <GradientStop Offset="0" Color="#180A0A"/>
    <GradientStop Offset="1" Color="#060202"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="ElGradToast" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#120808"/>
    <GradientStop Offset="0.6" Color="#1C0E0E"/>
    <GradientStop Offset="1" Color="#0E0808"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ElGradFloatingBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#1A0E0E"/>
    <GradientStop Offset="1" Color="#0A0606"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ElGradProgress" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="#A08020"/>
    <GradientStop Offset="1" Color="#D4AF37"/>
  </LinearGradientBrush>
  <Thickness x:Key="ElFrameThickness">1</Thickness>
  <Thickness x:Key="ElToastFrameThickness">1,1,1,1</Thickness>

  <!-- Radii -->
  <CornerRadius x:Key="ElRadiusWindow">28</CornerRadius>
  <CornerRadius x:Key="ElRadiusHero">26</CornerRadius>
  <CornerRadius x:Key="ElRadiusFeature">24</CornerRadius>
  <CornerRadius x:Key="ElRadiusCard">22</CornerRadius>
  <CornerRadius x:Key="ElRadiusTile">20</CornerRadius>
  <CornerRadius x:Key="ElRadiusNavCard">18</CornerRadius>
  <CornerRadius x:Key="ElRadiusThumb">16</CornerRadius>
  <CornerRadius x:Key="ElRadiusControl">14</CornerRadius>
  <CornerRadius x:Key="ElRadiusButton">13</CornerRadius>
  <CornerRadius x:Key="ElRadiusSegmented">12</CornerRadius>
  <CornerRadius x:Key="ElRadiusSegment">9</CornerRadius>
  <CornerRadius x:Key="ElRadiusRow">9</CornerRadius>
  <CornerRadius x:Key="ElRadiusKbd">6</CornerRadius>
  <CornerRadius x:Key="ElRadiusPill">999</CornerRadius>
  <CornerRadius x:Key="ElRadiusNavMarker">0,4,4,0</CornerRadius>

  <!-- Spacing and sizes (double) -->
  <x:Double x:Key="ElSpace1">4</x:Double>
  <x:Double x:Key="ElSpace2">8</x:Double>
  <x:Double x:Key="ElSpace3">12</x:Double>
  <x:Double x:Key="ElSpace4">16</x:Double>
  <x:Double x:Key="ElSpace5">20</x:Double>
  <x:Double x:Key="ElSpace6">24</x:Double>
  <x:Double x:Key="ElSpace7">28</x:Double>
  <x:Double x:Key="ElSpace8">32</x:Double>
  <x:Double x:Key="ElSpaceChipGap">8</x:Double>
  <x:Double x:Key="ElSpaceStack">12</x:Double>
  <x:Double x:Key="ElSpaceTileGap">16</x:Double>
  <x:Double x:Key="ElSpaceGridGap">20</x:Double>
  <x:Double x:Key="ElSpaceSectionGap">22</x:Double>
  <x:Double x:Key="ElSpaceWindowPad">28</x:Double>
  <x:Double x:Key="ElSpaceNavPadX">30</x:Double>
  <x:Double x:Key="ElSpaceCardPad">18</x:Double>
  <x:Double x:Key="ElSpaceFeaturePad">22</x:Double>
  <x:Double x:Key="ElSizeNavWidth">220</x:Double>
  <x:Double x:Key="ElSizeNavItem">46</x:Double>
  <x:Double x:Key="ElSizeNavMarkerW">4</x:Double>
  <x:Double x:Key="ElSizeTopbar">46</x:Double>
  <x:Double x:Key="ElSizeSearchH">44</x:Double>
  <x:Double x:Key="ElSizeSearchW">430</x:Double>
  <x:Double x:Key="ElSizeIconButton">44</x:Double>
  <x:Double x:Key="ElSizeControlH">44</x:Double>
  <x:Double x:Key="ElSizeButtonH">42</x:Double>
  <x:Double x:Key="ElSizeChipH">30</x:Double>
  <x:Double x:Key="ElSizeRowH">29</x:Double>
  <x:Double x:Key="ElSizeCaptionW">46</x:Double>
  <x:Double x:Key="ElSizeCaptionH">34</x:Double>
  <x:Double x:Key="ElSizeHeroRowH">330</x:Double>
  <x:Double x:Key="ElSizeDetailColW">322</x:Double>
  <x:Double x:Key="ElSizeThumbRowH">64</x:Double>
  <x:Double x:Key="ElSizeIcon">20</x:Double>
  <x:Double x:Key="ElSizeIconSm">16</x:Double>
  <x:Double x:Key="ElSizeIconStroke">1.7</x:Double>
  <Thickness x:Key="ElCardPadding">18,18,18,14</Thickness>
  <Thickness x:Key="ElFeaturePadding">22,22,22,20</Thickness>
  <Thickness x:Key="ElMainPadding">6,28,30,28</Thickness>
  <Thickness x:Key="ElChipPadding">14,0,14,0</Thickness>
  <Thickness x:Key="ElButtonPadding">22,0,22,0</Thickness>

  <!-- Shadows and coloured glows (BoxShadows parses "x y blur spread color", comma separated; "inset" prefix allowed) -->
  <BoxShadows x:Key="ElShadowWindow">0 40 90 0 #8C000000, 0 0 0 1 #FF5A2020</BoxShadows>
  <BoxShadows x:Key="ElShadowHeroGlow">0 26 60 -18 #8C8A2A35</BoxShadows>
  <BoxShadows x:Key="ElShadowFeatureGlow">0 22 50 -16 #8CB45A28</BoxShadows>
  <BoxShadows x:Key="ElShadowGoldButton">0 2 10 0 #2ED4AF37</BoxShadows>
  <BoxShadows x:Key="ElShadowNavMarker">0 0 14 0 #8CD4AF37</BoxShadows>
  <BoxShadows x:Key="ElShadowDotRing">0 0 0 2 #FF221212</BoxShadows>
  <BoxShadows x:Key="ElShadowMenu">0 18 40 -12 #99000000, 0 0 0 1 #FF4A2020</BoxShadows>
  <BoxShadows x:Key="ElShadowCard">0 4 24 0 #59000000, inset 0 1 0 0 #0AFFFFFF</BoxShadows>
  <BoxShadows x:Key="ElShadowCrimsonButton">0 0 0 4 #26C41E3A, 0 4 16 0 #99000000</BoxShadows>
  <BoxShadows x:Key="ElShadowFloatingBar">0 0 0 1 #FF5A2020, 0 4 16 0 #B3000000</BoxShadows>

  <!-- Fonts: static TTFs shipped under OFL in Assets/Fonts (see fonts/README.md) -->
  <FontFamily x:Key="ElFontUi">avares://EliteLevel.Avalonia/Assets/Fonts#Plus Jakarta Sans</FontFamily>
  <FontFamily x:Key="ElFontMono">avares://EliteLevel.Avalonia/Assets/Fonts#DM Mono</FontFamily>
  <x:Double x:Key="ElTypeHeroSize">54</x:Double>
  <FontWeight x:Key="ElTypeHeroWeight">800</FontWeight>
  <x:Double x:Key="ElTypeHeroTracking">-1.89</x:Double> <!-- TextBlock.LetterSpacing in px (-0.035em) -->
  <x:Double x:Key="ElTypeDisplaySmSize">40</x:Double>
  <FontWeight x:Key="ElTypeDisplaySmWeight">800</FontWeight>
  <x:Double x:Key="ElTypeDisplaySmTracking">-1.2</x:Double> <!-- TextBlock.LetterSpacing in px (-0.03em) -->
  <x:Double x:Key="ElTypeFeatureSize">22</x:Double>
  <FontWeight x:Key="ElTypeFeatureWeight">700</FontWeight>
  <x:Double x:Key="ElTypeFeatureTracking">-0.44</x:Double> <!-- TextBlock.LetterSpacing in px (-0.02em) -->
  <x:Double x:Key="ElTypeSectionSize">17</x:Double>
  <FontWeight x:Key="ElTypeSectionWeight">700</FontWeight>
  <x:Double x:Key="ElTypeSectionTracking">-0.26</x:Double> <!-- TextBlock.LetterSpacing in px (-0.015em) -->
  <x:Double x:Key="ElTypeWordmarkSize">17</x:Double>
  <FontWeight x:Key="ElTypeWordmarkWeight">700</FontWeight>
  <x:Double x:Key="ElTypeWordmarkTracking">-0.17</x:Double> <!-- TextBlock.LetterSpacing in px (-0.01em) -->
